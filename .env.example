# Local/dev behavior
WEAVE_ENV=development
WEAVE_DEBUG=1
# Supabase connection used by server.py (the weave remote transport).
# Copy to .env and fill in for your project. Use the service-role key so the
# server bypasses row-level security on weave_sessions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key
